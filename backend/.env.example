# Copy this file to backend/.env; paste credentials locally, never into chat or Git.
# Neon Connect dialog: pooling enabled, for the application's runtime connection.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=verify-full"
# Same Neon branch/database: pooling disabled, for Prisma CLI migrations and Studio.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=verify-full"
# Optional: PORT=3000
# Generate locally with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="REPLACE_WITH_64_RANDOM_HEX_CHARACTERS"
FRONTEND_ORIGINS="http://localhost:5173"

# Hosting only: set NODE_ENV=production; FRONTEND_ORIGINS must then use exact HTTPS origins.
# Keep local HTTP origins for development only; do not use wildcard preview domains.
