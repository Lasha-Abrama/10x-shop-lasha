{
  "name": "@10x-shop/backend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run prisma:generate && node --env-file-if-exists=.env --watch --require ts-node/register src/main.ts",
    "typecheck": "npm run prisma:generate && tsc --noEmit",
    "build": "npm run prisma:generate && tsc",
    "test": "npm run build && node --test tests/*.test.cjs",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:status": "prisma migrate status",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.7",
    "@types/node": "^24.0.0",
    "prisma": "7.10.1",
    "ts-node": "^10.9.2"
  }
}
